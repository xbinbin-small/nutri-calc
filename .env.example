# 构建期注入前端的公开变量（Vite）。复制为 .env 后填值；切勿放后端 secret。

# Cloudflare Turnstile 站点密钥
VITE_TURNSTILE_SITE_KEY=

# ── Google AdSense（公开）。留空 = 不加载广告，仅开发环境显示占位 ──
# 发布商 ID，形如 ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# 广告单元 ID（AdSense 后台为每个广告位生成的 data-ad-slot 数字串）
VITE_ADSENSE_SLOT_RAIL=
VITE_ADSENSE_SLOT_INLINE=

# ── 打赏渠道（公开）。留空的渠道自动隐藏 ──
VITE_BMC_USERNAME=
VITE_AFDIAN_URL=
# 设为 1 时显示微信/支付宝收款码弹窗（需放 public/donate-wechat.png、public/donate-alipay.png）
VITE_DONATE_QR=
